{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/tick",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "app/api/queues/heartbeat/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "pundit-heartbeat", "retryAfterSeconds": 30 }]
    }
  },
  "framework": "nextjs"
}
