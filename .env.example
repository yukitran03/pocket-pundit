# Tatum (dashboard.tatum.io) — mainnet key, used for Sui gRPC + GraphQL
TATUM_API_KEY=

# Walrus Memory (memory.walrus.xyz → Delegate keys)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# App
APP_SECRET=          # keep stable: user namespaces are derived from it
CRON_SECRET=
APP_URL=http://localhost:3000
DATABASE_URL=        # Neon Postgres; leave empty to use embedded PGlite in ./data
FOOTBALL_API_BASE=   # base URL of the public football data API
PUBLIC_FEED_USER=    # optional Telegram user id whose lessons appear on the landing page
OFFICIAL_CRESTS=     # optional: 1 shows the feed's official team pictures (off by default; clear licensing first)
MEMWAL_PUBLIC_KEY=   # optional: delegate public key hex (derived from MEMWAL_PRIVATE_KEY when empty)
